{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://giwg.example/schemas/rfi.json",
  "title": "GIWG Request for Information (RFI)",
  "description": "Two-way planning and adjudication support exchange with SLA and response tracking .",
  "type": "object",
  "required": [
    "rfi_id",
    "requesting_team_id",
    "question",
    "priority",
    "status",
    "opened_at"
  ],
  "additionalProperties": false,
  "properties": {
    "rfi_id": {
      "type": "string",
      "format": "uuid"
    },
    "requesting_team_id": {
      "type": "string",
      "format": "uuid"
    },
    "turn_id": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    },
    "question": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "topic": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 200
    },
    "priority": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high",
        "urgent"
      ],
      "default": "medium"
    },
    "status": {
      "type": "string",
      "enum": [
        "open",
        "assigned",
        "answered",
        "closed",
        "escalated"
      ],
      "maxLength": 30
    },
    "owner_participant_id": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    },
    "opened_at": {
      "type": "string",
      "format": "date-time"
    },
    "due_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "closed_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "responses": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "response_id",
          "content",
          "responded_at"
        ],
        "additionalProperties": false,
        "properties": {
          "response_id": {
            "type": "string",
            "format": "uuid"
          },
          "artifact_id": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid"
          },
          "content": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "producer_id": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid"
          },
          "confidence": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 30
          },
          "responded_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    },
    "related_move_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "format": "uuid"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "assigned"
          }
        }
      },
      "then": {
        "properties": {
          "owner_participant_id": {
            "type": "string",
            "format": "uuid"
          }
        },
        "required": [
          "owner_participant_id"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "answered",
              "closed"
            ]
          }
        }
      },
      "then": {
        "required": [
          "responses"
        ],
        "properties": {
          "responses": {
            "type": "array",
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "closed"
          }
        }
      },
      "then": {
        "properties": {
          "closed_at": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "closed_at"
        ]
      }
    }
  ]
}
